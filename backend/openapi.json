{
  "openapi": "3.1.0",
  "info": {
    "title": "InfraSense API",
    "description": "Backend REST API for Karnataka District Development and Infrastructure Analytics.",
    "version": "1.0.0"
  },
  "paths": {
    "/districts": {
      "get": {
        "tags": [
          "districts"
        ],
        "summary": "Get All Districts",
        "description": "List all 31 districts with basic master data.",
        "operationId": "get_all_districts_districts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DistrictSummary"
                  },
                  "type": "array",
                  "title": "Response Get All Districts Districts Get"
                }
              }
            }
          }
        }
      }
    },
    "/districts/{district_id}": {
      "get": {
        "tags": [
          "districts"
        ],
        "summary": "Get District Profile",
        "description": "Return full development profile for a single district.",
        "operationId": "get_district_profile_districts__district_id__get",
        "parameters": [
          {
            "name": "district_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "District Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistrictProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/indicators": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "List Indicators",
        "description": "List all 14 indicators with metadata (code, name, dimension, direction, unit).",
        "operationId": "list_indicators_indicators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IndicatorInfo"
                  },
                  "type": "array",
                  "title": "Response List Indicators Indicators Get"
                }
              }
            }
          }
        }
      }
    },
    "/indicators/stats": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "Get Indicator Stats",
        "description": "Return descriptive statistics for all 14 indicators.",
        "operationId": "get_indicator_stats_indicators_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IndicatorStats"
                  },
                  "type": "array",
                  "title": "Response Get Indicator Stats Indicators Stats Get"
                }
              }
            }
          }
        }
      }
    },
    "/rankings/overall": {
      "get": {
        "tags": [
          "rankings"
        ],
        "summary": "Get Overall Rankings",
        "description": "Return all 31 districts ranked by their composite overall development score.",
        "operationId": "get_overall_rankings_rankings_overall_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RankingEntry"
                  },
                  "type": "array",
                  "title": "Response Get Overall Rankings Rankings Overall Get"
                }
              }
            }
          }
        }
      }
    },
    "/rankings/dimension/{dimension}": {
      "get": {
        "tags": [
          "rankings"
        ],
        "summary": "Get Dimension Rankings",
        "description": "Return district rankings for a specific development dimension.",
        "operationId": "get_dimension_rankings_rankings_dimension__dimension__get",
        "parameters": [
          {
            "name": "dimension",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dimension"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DimensionRankingEntry"
                  },
                  "title": "Response Get Dimension Rankings Rankings Dimension  Dimension  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clusters": {
      "get": {
        "tags": [
          "clusters"
        ],
        "summary": "Get Cluster Summary",
        "description": "Return summary of all clusters from the latest K-Means analysis run.",
        "operationId": "get_cluster_summary_clusters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClusterSummaryEntry"
                  },
                  "type": "array",
                  "title": "Response Get Cluster Summary Clusters Get"
                }
              }
            }
          }
        }
      }
    },
    "/clusters/{cluster_id}": {
      "get": {
        "tags": [
          "clusters"
        ],
        "summary": "Get Cluster Districts",
        "description": "Return all districts assigned to a given cluster label.",
        "operationId": "get_cluster_districts_clusters__cluster_id__get",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Cluster Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClusterDetail"
                  },
                  "title": "Response Get Cluster Districts Clusters  Cluster Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/compare": {
      "get": {
        "tags": [
          "compare"
        ],
        "summary": "Compare Districts",
        "description": "Side-by-side comparison of 2 to 5 districts across all 14 indicators\nand composite overall score.",
        "operationId": "compare_districts_compare_get",
        "parameters": [
          {
            "name": "districts",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Comma-separated district IDs, e.g. KA-001,KA-005",
              "title": "Districts"
            },
            "description": "Comma-separated district IDs, e.g. KA-001,KA-005"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompareEntry"
                  },
                  "title": "Response Compare Districts Compare Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations/{district_id}": {
      "get": {
        "tags": [
          "recommendations"
        ],
        "summary": "Get Recommendations For District",
        "description": "Return prioritised policy and infrastructure recommendations for a given district.\nQueries district_recommendations table, falling back to computed weakest indicators\nif the table is empty or missing.",
        "operationId": "get_recommendations_for_district_recommendations__district_id__get",
        "parameters": [
          {
            "name": "district_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "District Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecommendationEntry"
                  },
                  "title": "Response Get Recommendations For District Recommendations  District Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/eda/disparity": {
      "get": {
        "tags": [
          "eda"
        ],
        "summary": "Get Regional Disparity",
        "description": "Return indicators ranked by highest regional disparity (inter-district spread).",
        "operationId": "get_regional_disparity_eda_disparity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EDADisparityEntry"
                  },
                  "type": "array",
                  "title": "Response Get Regional Disparity Eda Disparity Get"
                }
              }
            }
          }
        }
      }
    },
    "/eda/outliers": {
      "get": {
        "tags": [
          "eda"
        ],
        "summary": "Get Indicator Outliers",
        "description": "Return districts with indicator values differing by > 2 standard deviations from state mean.",
        "operationId": "get_indicator_outliers_eda_outliers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EDAOutlierEntry"
                  },
                  "type": "array",
                  "title": "Response Get Indicator Outliers Eda Outliers Get"
                }
              }
            }
          }
        }
      }
    },
    "/eda/unevenness": {
      "get": {
        "tags": [
          "eda"
        ],
        "summary": "Get Development Unevenness",
        "description": "Return districts ranked by internal development imbalance (highest score range across dimensions).",
        "operationId": "get_development_unevenness_eda_unevenness_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EDAUnevennessEntry"
                  },
                  "type": "array",
                  "title": "Response Get Development Unevenness Eda Unevenness Get"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "root"
        ],
        "summary": "Root",
        "description": "Health check and API metadata.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    }
